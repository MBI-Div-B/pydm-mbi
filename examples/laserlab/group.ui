<?xml version="1.0" encoding="UTF-8"?>
<!--
  A group of devices of one class, one row each, e.g. all pressure gauges.
  Macros:
    TITLE    heading, e.g. "Pressure gauges"
    ROW      row template, e.g. "panels/pressuregauge/row.ui" (macros DEVICE and LABEL)
    DEVICES  device list, e.g. "lists/pressure_gauges.json": [{"DEVICE": ..., "LABEL": ...}, ...]
  Open with a PyDMRelatedDisplayButton: filename "group.ui", macros {"TITLE": ..., "ROW": ..., "DEVICES": ...}
-->
